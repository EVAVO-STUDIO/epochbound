						{
							"id": "leave",
							"text": "Leave the archivist to the catalogues.",
							"conditions": [],
							"effects": [],
							"next": "end"
						}
					],
					"editor_position": {"x": 360, "y": 120}
				},
				{
					"id": "missing_hour_assignment",
					"kind": "line",
					"speaker": "LOST ARCHIVIST",
					"text": "‘First find the name the well remembers. Then make a lens from the fragments the clock keeps shedding. Bring it back before another age notices the gap.’",
					"next": "end",
					"conditions": [],
					"effects": [],
					"editor_position": {"x": 760, "y": 40}
				},
				{
					"id": "current_work",
					"kind": "line",
					"speaker": "LOST ARCHIVIST",
					"text": "‘The journal knows your present objective. Trust the evidence you have, not the order in which the ages offer it.’",
					"next": "end",
					"conditions": [],
					"effects": [],
					"editor_position": {"x": 760, "y": 170}
				},
				{
					"id": "returned_hour",
					"kind": "line",
					"speaker": "LOST ARCHIVIST",
					"text": "The lens catches an absent chime. For one breath, the museum, the crossing and the clockwood share the same shadow. ‘There. The hour remembers where it belongs.’",
					"next": "end",
					"conditions": [],
					"effects": [],
					"editor_position": {"x": 760, "y": 300}
				},
				{
					"id": "after_hour",
					"kind": "line",
					"speaker": "LOST ARCHIVIST",
					"text": "‘It will hold until someone tries to remember what happened inside it. That is why we must reach the lower galleries first.’",
					"next": "end",
					"conditions": [],
					"effects": [],
					"editor_position": {"x": 760, "y": 430}
				},
				{
					"id": "hunt_assignment",
					"kind": "line",
					"speaker": "LOST ARCHIVIST",
					"text": "‘The Ash Hound is not hunting you. It is hunting the sound your arrival made. Quiet it before the rhythm reaches the gate.’",
					"next": "end",
					"conditions": [],
					"effects": [],
					"editor_position": {"x": 760, "y": 560}
				},
				{
					"id": "hunt_work",
					"kind": "line",
					"speaker": "LOST ARCHIVIST",
					"text": "‘When the eastern ash goes still, the hunt is over. Until then, do not let it pull Morrow beyond the brass path.’",
					"next": "end",
					"conditions": [],
					"effects": [],
					"editor_position": {"x": 760, "y": 690}
				},
				{
					"id": "end",
					"kind": "end",
					"effects": [],
					"editor_position": {"x": 1080, "y": 300}
				}
