; Engine configuration file.
; Epochbound — Godot 4.6.2

config_version=5

[application]

config/name="Epochbound"
run/main_scene="res://src/app.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/use_custom_user_dir=true
config/custom_user_dir_name="EVAVO/Epochbound"
boot_splash/bg_color=Color(0.015, 0.02, 0.027, 1)
boot_splash/show_image=false

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/epochbound_campaign_studio/plugin.cfg", "res://addons/epochbound_encounter_studio/plugin.cfg", "res://addons/epochbound_combat_director/plugin.cfg", "res://addons/epochbound_companion_studio/plugin.cfg", "res://addons/epochbound_item_forge/plugin.cfg", "res://addons/epochbound_story_studio/plugin.cfg", "res://addons/epochbound_save_state_studio/plugin.cfg", "res://addons/epochbound_loadout_studio/plugin.cfg", "res://addons/epochbound_trade_studio/plugin.cfg", "res://addons/epochbound_arsenal_studio/plugin.cfg", "res://addons/epochbound_boss_studio/plugin.cfg", "res://addons/epochbound_cinematic_studio/plugin.cfg", "res://addons/epochbound_package_studio/plugin.cfg", "res://addons/epochbound_campaign_audit/plugin.cfg", "res://addons/epochbound_presentation_studio/plugin.cfg", "res://addons/epochbound_audio_mood_studio/plugin.cfg", "res://addons/epochbound_sprite_animation_studio/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true

[audio]

default_bus_layout="res://default_bus_layout.tres"

[input]

move_left={
"deadzone": 0.25,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194311), Object(InputEventJoypadButton,"button_index":13)]
}
