	"interactions": [
		{
			"id": "archive_hearth_station",
			"kind": "hideaway_facility",
			"facility_id": "archive_hearth",
			"position": {
				"x": 168,
				"y": 218
			},
			"radius": 44,
			"available_eras": [],
			"dialogue": {
				"verdant": "Dry cedar waits beside the Archive Hearth. Morrow has already claimed the warmest flagstone.",
				"ashen": "Cinders tap the chimney stone, but the Archive Hearth keeps one clean pocket of heat.",
				"default": "The Archive Hearth can turn salvage and a safe return into preparation."
			}
		},
		{
			"id": "sheltered_coldframe_station",
			"kind": "hideaway_facility",
			"facility_id": "sheltered_coldframe",
			"position": {
				"x": 300,
				"y": 182
			},
			"radius": 44,
			"available_eras": [],
			"dialogue": {
				"verdant": "The Sheltered Coldframe holds hardy leaves gathered between expeditions, not a chore calendar.",
				"ashen": "The panes are filmed with ash; a few stubborn medicinal leaves still hold their colour.",
				"default": "The Sheltered Coldframe preserves a small reserve for the road."
			}
		},
		{
			"id": "salvage_workbench_station",
			"kind": "hideaway_facility",
			"facility_id": "salvage_workbench",
			"position": {
				"x": 438,
				"y": 218
			},
			"radius": 46,
			"available_eras": [],
			"dialogue": {
				"verdant": "Brass teeth, leather wraps and bent museum fittings wait in careful little rows.",
				"ashen": "The Salvage Workbench smells of hot metal. Every useful piece has been cleaned twice.",
				"default": "The Salvage Workbench turns recovered scraps into expedition readiness."
			}
		},
		{
			"id": "morrows_corner_station",
			"kind": "hideaway_facility",
			"facility_id": "morrows_corner",
			"position": {
				"x": 314,
				"y": 274
			},
			"radius": 46,
			"available_eras": [],
			"dialogue": {
				"verdant": "Morrow's blanket, bowl and chewed leather strap make this corner more home than museum.",
				"ashen": "Morrow sleeps lightly here, one ear turned toward the impossible weather outside.",
				"default": "Morrow's Corner is a place to settle before asking him to face the road again."
			}
		},
		{
			"id": "memento_shelf_station",
			"kind": "hideaway_memento_shelf",
			"position": {
				"x": 526,
				"y": 174
			},
			"radius": 44,
			"available_eras": [],
			"dialogue": {
				"verdant": "A narrow shelf holds the things Eli and Morrow carried home instead of selling or leaving behind.",
				"ashen": "Cinder settles around the shelf, never over the small objects that still remember the road.",
				"default": "The memento shelf records what the journey changed without turning memory into currency."
			}
		},
		{
			"id": "quiet_moments_station",
			"kind": "hideaway_quiet_moments",
			"position": {
				"x": 222,
				"y": 272
			},
			"radius": 38,
			"available_eras": [],
			"dialogue": {
				"verdant": "Two low cushions face the Archive Hearth. Nothing here asks to be completed.",
				"ashen": "The hearthside nook is warm enough to sit without planning the next escape.",
				"default": "The quiet nook holds optional moments with Morrow. Listening spends nothing and advances no time."
			}
		}
