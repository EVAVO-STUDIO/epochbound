					"speaker": "LOST ARCHIVIST",
					"text": {
						"verdant": "The archivist closes a catalogue that has not been printed yet. ‘You and the hound arrived between one chime and the next.’",
						"ashen": "The archivist watches ash pass through their sleeves. ‘The hour is still missing. In this age, everything inside it is burning.’",
						"default": "The archivist studies Eli as though checking an accession number."
					},
					"next": "questions",
					"conditions": [],
					"effects": [],
					"editor_position": {"x": 80, "y": 180}
				},
