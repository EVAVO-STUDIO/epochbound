			],
			"reflection_keys": {
				"verdant": "ui.hideaway.memento.well_name_rubbing.verdant",
				"ashen": "ui.hideaway.memento.well_name_rubbing.ashen"
			},
			"reflection": {
				"verdant": "Charcoal catches the letters the old well remembered. Eli cannot read the name aloud without hearing water below the floor.",
				"ashen": "The rubbing has darkened, but the buried name is still legible. Morrow’s ears lift before Eli reaches the final letter."
			}
		},
		{
			"id": "absent_chime_case",
