							"text": "Show the Clockglass Lens.",
							"conditions": [
								{"type": "quest_stage", "quest_id": "the_missing_hour", "stage_id": "return_to_archivist"},
								{"type": "has_item", "item_id": "clockglass_lens", "quantity": 1}
