				"ashen": "ui.hideaway.memento.quieted_ash_mark.ashen"
			},
			"reflection": {
				"verdant": "A resin-dark strip from the eastern path hangs without moving. Morrow no longer hears the brass rhythm inside it.",
				"ashen": "The strip is warm to the touch, but the hunt has gone silent. Morrow sleeps through the hour it once prowled."
			}
		},
		{
			"id": "released_accession_plate",
			"display_name_key": "ui.hideaway.memento.released_accession_plate.name",
